        "deep-diff": "^1.0.2",
        "deep-equal": "^2.2.3",
        "dexie": "^4.4.2",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "fake-indexeddb": "^6.2.5",
        "is-mobile": "^5.0.0",
        "lodash": "^4.18.1",
        "lodash.debounce": "^4.0.8",
        "mini-css-extract-plugin": "^2.10.2",
        "mustache": "^4.2.0",
        "node-fetch": "^3.3.2",
        "normalize.css": "^8.0.1",
        "path": "^0.12.7",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "postcss": "^8.5.15",
        "prop-types": "^15.8.1",
