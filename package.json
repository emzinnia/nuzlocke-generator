{
    "name": "nuzlocke-generator",
    "version": "1.23.0",
    "description": "A tool for generating nuzlocke team pics from data",
    "main": "dist/bundle.js",
    "type": "module",
    "scripts": {
        "dev": "vite --host",
        "dev:debug": "DEBUG=* vite --host",
        "build:production": "vite build --mode production",
        "build": "vite build",
        "build:watch": "vite build --watch",
        "preview": "vite preview --host",
        "clean": "rimraf dist",
        "clean:all": "rimraf dist coverage node_modules/.cache node_modules/.vite",
        "scrape:pokedex:full": "node scripts/download-pokedex-full.mjs --from 891 --to 1025",
        "deploy": "npm run build && git push heroku master",
        "lint": "npx eslint",
        "lint:fix": "npx eslint --fix",
        "lint:errors": "npx eslint --quiet",
        "prebuild": "rm -rf ./dist",
        "precommit": "npm run lint",
        "pretest": "npm run lint",
        "serve:heroku": "npm run build:production && heroku local web",
        "serve:node": "npx tsx server.ts",
        "serve:http": "npx http-server@0.12.0 --cors ./dist",
        "serve:forever": "npx forever start -c 'npm run server:node' ./",
        "serve": "npm run dev",
        "start": "npm run serve",
        "start:ci": "npm start",
        "test": "vitest --coverage",
        "test:run": "vitest run",
        "test:watch": "vitest watch",
        "test:ui": "vitest --ui",
        "test:changed": "vitest run --changed",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "typecheck": "tsc --noEmit",
        "typecheck:watch": "tsc --noEmit --watch",
        "validate": "npm run typecheck && npm run lint && npm run test:run",
        "todos": "npx leasot 'src/**/*.tsx' 'src/**/*.ts'",
        "lh": "npx lighthouse http://localhost:8080 --output-path=./lighthouse/audit.html --save-assets --preset=desktop --quiet --chrome-flags=headless",
        "images:check": "npx tsx scripts/imageCheck.ts",
        "sprites:pokesprite": "npx tsx scripts/download-pokesprite-icons.ts",
        "sprites:pokesprite:dry-run": "npx tsx scripts/download-pokesprite-icons.ts --dry-run"
    },
    "engines": {
        "node": "^24",
        "npm": ">=11"
    },
    "keywords": [],
    "author": "Emma Ramirez <ramireze.emma.g@gmail.com> (http://emmaramirez.me)",
    "license": "MIT",
    "dependencies": {
        "@babel/plugin-proposal-decorators": "^7.29.0",
        "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
        "@babel/plugin-transform-modules-commonjs": "^7.28.6",
        "@babel/preset-react": "^7.28.5",
        "@babel/preset-typescript": "^7.28.5",
        "@blueprintjs/select": "^6.2.1",
        "@builder.io/partytown": "^0.10.3",
        "@emmaramirez/dom-to-image": "^3.0.2",
        "@emotion/css": "^11.13.5",
        "@react-hook/debounce": "^4.0.0",
        "@types/react-dnd-html5-backend": "^3.0.2",
        "@vercel/analytics": "^2.0.1",
        "@vitejs/plugin-react": "^6.0.2",
        "autoprefixer": "^10.5.0",
        "babel-loader": "^10.1.1",
        "babel-plugin-bundled-import-meta": "^0.3.2",
        "babel-plugin-macros": "^3.1.0",
        "babel-plugin-module-resolver": "^5.0.3",
        "babel-plugin-search-and-replace": "^1.1.1",
        "buffer": "^6.0.3",
        "color": "^5.0.3",
        "compression": "^1.8.1",
