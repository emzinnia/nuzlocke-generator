        "react-docgen-typescript": "^2.4.0",
        "react-dom": "^19.2.6",
        "react-loadable": "^5.5.0",
        "react-markdown": "^10.1.0",
        "react-polyfills": "0.0.1",
        "react-test-renderer": "^19.2.6",
        "react-transition-group": "^4.4.5",
        "redux": "^5.0.1",
